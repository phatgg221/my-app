generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Stage {
  CONTRACT_SENT
  CONTRACT_SIGNED
  KYC_DOCS_RECEIVED
  KYC_VERIFIED
  ACTIVE
}

enum DocumentType {
  BUSINESS_LICENSE
  IDENTITY_DOCUMENT
  OTHER
}

model User {
  id        String         @id @default(uuid())
  name      String
  email     String?
  avatar    String?
  role      String?        @default("Ops Coordinator")
  histories StageHistory[]

  @@index([email])
}

model Vendor {
  id           String         @id @default(uuid())
  name         String
  region       String
  currentStage Stage          @default(CONTRACT_SENT)
  updatedAt    DateTime       @updatedAt

  histories StageHistory[]
  documents Document[]
}

model StageHistory {
  id            String   @id @default(uuid())
  vendorId      String
  userId        String
  previousStage Stage
  newStage      Stage
  changedAt     DateTime @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

model Document {
  id         String       @id @default(uuid())
  vendorId   String
  fileName   String
  fileKey    String       @unique
  fileUrl    String
  type       DocumentType @default(OTHER)
  uploadedAt DateTime     @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}
